@using GemManagment.BLL.ViewModels.Trainer
@using GemManagment.DAL.Models.Enums
@model TrainerToCreateViewModel
@{
    ViewData["Title"] = "Create";
}

<div class="container mt-4">
                <header class="mb-4">
                    <h3 class="text-primary-color">Add New Trainer</h3>
                </header>
               

                <form  asp-action="Create">

                    <!-- Trainer Info -->
                    <div class="section-header mb-3">
                        <h5 class="text-primary fw-bold">Personal Information</h5>
                        <hr class="mt-2">
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="Date" class="form-control" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>

                    </div>
                    <div class="section-header mb-3 mt-4">
                        <h5 class="text-primary fw-bold">Address Information</h5>
                        <hr class="mt-2">
                    </div>
                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label asp-for="BuildingNumber" class="form-label"></label>
                            <input asp-for="BuildingNumber" class="form-control" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                    </div>
                    <!-- Professional Information -->
                    <div class="section-header mb-3">
                        <h5 class="text-primary fw-bold">Professional Information</h5>
                        <hr class="mt-2">
                    </div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Specialty" class="form-label fw-semibold">
                                Specializations <span class="text-danger">*</span>
                            </label>
                            <select  class="form-control" asp-items="@Html.GetEnumSelectList<GeneralFitness>()"  asp-for="Specialty">
    <option readonly disable>-- select Specialty --</option>
</select>
                            @*  <environment class="form-control"    asp-for="Specialty" />

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Specialties"
                                    value="GeneralFitness" />
                                <label class="form-check-label">GeneralFitness</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Specialties" value="Yoga" />
                                <label class="form-check-label">Yoga</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Specialties" value="Boxing" />
                                <label class="form-check-label">Boxing</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Specialties" value="CrossFit" />
                                <label class="form-check-label">CrossFit</label>
                            </div> *@
                        </div>
                    </div>

                    <footer class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-fill">Add</button>
                    </footer>
                </form>

            </div>

