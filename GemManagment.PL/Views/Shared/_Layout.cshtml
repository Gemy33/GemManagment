
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- ^ Bootstrap 5.3.8 css file -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- ^ Our main css file -->
    <link rel="stylesheet" href="~/css/Style.css" />
    <title>Power fitness | Home</title>
</head>

<body>

    <!-- Mobile Top Bar -->
    <nav class="navbar navbar-light bg-white d-lg-none px-3">
        <a class="navbar-brand" href="#">
            <img src="~/images/logo.jpg" height="40" />
        </a>
        <button class="btn btn-outline-dark" type="button" data-bs-toggle="offcanvas"
                data-bs-target="#sidebarMenu">
            <i class="bi bi-list fs-3"></i>
        </button>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <nav id="sidebarMenu"
                 class="col-lg-3 ms-0  d-lg-block bg-body-secondary sidebar collapse offcanvas-lg offcanvas-start">

                <div class="position-fixed  psot   pt-4 vh-100">

                    <!-- Logo (Desktop) -->
                  @*   <div class="text-center mb-4 d-none d-lg-block">
                        <img src="~/images/logo.jpg" class="img-fluid" style="max-height:80px;" />
                    </div> *@

                    <ul class="nav flex-column text-center ms-0  text-lg-start">

                        <li class="nav-item">
                            <a class="nav-link fw-bold fs-5" asp-action="Index" asp-controller="Home">
                                <i class="bi bi-house me-2"></i> Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold fs-5"
                               asp-action="Index" asp-controller="Member">
                                <i class="bi bi-people me-2"></i> Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold fs-5"
                               asp-action="Index" asp-controller="Traineer">
                                <i class="bi bi-person-badge me-2"></i> Trainers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold fs-5"
                               asp-action="Index" asp-controller="Session">
                                <i class="bi bi-calendar-event me-2"></i> Sessions
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold fs-5"
                               asp-action="Index" asp-controller="Plan">
                                <i class="bi bi-card-checklist me-2"></i> Plans
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold fs-5"
                               asp-action="Index" asp-controller="MemberShip">
                                <i class="bi bi-award "></i> Memberships
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-bold fs-5"
                               asp-controller="MemberSession" asp-action="Index">
                                <i class="bi bi-clock-history me-2"></i> SessionsSchedule
                            </a>
                        </li>

                        <li class="nav-item mt-3">
                            <form asp-action="Logout" asp-controller="Account"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-outline-danger w-100">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </form>
                        </li>

                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-lg-10 ms-sm-auto px-lg-4 py-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
